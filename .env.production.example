# ─────────────────────────────────────────────────────────────
# Learnova LMS — production environment template
#
# Copy the values into your hosting provider (Vercel → Project →
# Settings → Environment Variables). Do not commit real keys.
# ─────────────────────────────────────────────────────────────

# Hosted Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role / secret key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL of the deployed app. Confirmation and reset emails
# point here, so it must match the Supabase Auth Site URL.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Learnova confirms new signups server-side and signs them in immediately, so no
# verification email is required and no extra flag is needed here.

# Optional: only used by scripts/seed.ts. Never needed at runtime.
SEED_PASSWORD=

# Optional: floating support button. The email falls back to the platform
# setting, then NEXT_PUBLIC_SUPPORT_EMAIL, then support@learnova.test.
# WhatsApp is hidden until a number is set. Use full international format
# without spaces or symbols, for example 201234567890.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
