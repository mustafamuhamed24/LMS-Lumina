# ─────────────────────────────────────────────────────────────
# Learnova LMS environment
# Copy to .env.local and fill in values.
# NEVER expose the service role key to the browser.
# ─────────────────────────────────────────────────────────────

# Public Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role / secret key (admin API, privileged operations)
SUPABASE_SERVICE_ROLE_KEY=
# Canonical application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo accounts password used by scripts/seed.ts
SEED_PASSWORD=Passw0rd!

# Optional: floating support button (email falls back to the platform setting)
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: WhatsApp in international format, e.g. 201234567890
NEXT_PUBLIC_SUPPORT_WHATSAPP=
